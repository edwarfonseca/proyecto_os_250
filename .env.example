# =====================================================================
# EntregaSegura · Variables de entorno (PLANTILLA SIN VALORES REALES)
# Para crear tu .env con contraseñas aleatorias ejecuta:
#     ./scripts/generar_env.sh
# El .env NUNCA se sube al repositorio (está en .gitignore).
# =====================================================================

# --- Base de datos ---
POSTGRES_DB=entregasegura
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_API_DB_PASSWORD=
APP_WORKER_DB_PASSWORD=

# --- API ---
JWT_SECRET=
# true solo si se sirve por HTTPS
COOKIE_SECURE=false
# contraseña del usuario "admin" (mín. 10 caracteres)
ADMIN_PASSWORD=
# contraseña de todos los usuarios demo (mín. 10 caracteres)
DEMO_PASSWORD=
# crea docentes, estudiantes y cursos de ejemplo
SEED_DEMO=true
LOG_LEVEL=info

# --- Proxy ---
HTTP_PORT=80

# --- Worker ---
# trabajos en paralelo (la prueba de carga usa 1 y 2)
WORKER_CONCURRENCY=1
# tras cuántos segundos un trabajo "en_ejecucion" se da por colgado
RECUPERAR_TRAS_SEG=300
# SOLO para demos: retraso artificial por trabajo, en milisegundos
WORKER_DEMORA_MS=0
